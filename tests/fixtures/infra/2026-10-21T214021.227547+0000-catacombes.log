{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wk7WVpjbakdyAUS6THBdoD","type":"tool_result","content":"1\t\"\"\"Tools atomiques exposés au LLM (MCP) et au CLI. Chaque fonction fait UNE chose, est idempotente,\n2\tet lève une erreur explicite quand elle ne s'applique pas (le LLM fait alors autrement).\"\"\"\n3\tfrom __future__ import annotations\n4\t\n5\tfrom . import compose, config, dns, paths, secrets, stack\n6\tfrom .render import Target, missing_env_vars, render_env, traefik_labels\n7\tfrom .render import render as _render\n8\t\n9\t\n10\tdef _target(project: str, pr: int | None = None) -> Target:\n11\t    return Target(project, config.project(project), config.host(), pr)\n12\t\n13\t\n14\tdef host_info() -> dict:\n15\t    \"\"\"Décrit l'hôte : host.yaml (IP Tailscale, zones DNS, mode d'ingress public, tunnel, stacks, exceptions), chemins conventionnels.\"\"\"\n16\t    h = config.host()\n17\t    return {\n18\t        \"host\": h.model_dump(),\n19\t        \"paths\": {\"config\": str(paths.config_dir()), \"tool\": str(paths.tool_dir()), \"apps\": str(paths.apps_dir()),\n20\t                  \"data\": str(paths.data_dir()), \"stack_state\": str(paths.stack_state_dir())},\n21\t        \"conventions\": str(paths.tool_dir() / \"docs\" / \"conventions.md\"),\n22\t    }\n23\t\n24\t\n25\tdef registry_get(project: str | None = None) -> dict:\n26\t    \"\"\"Lit registry.yaml : l'entrée d'un projet, ou toutes.\"\"\"\n27\t    reg = config.registry()\n28\t    if project:\n29\t        return {project: config.project(project).model_dump()}\n30\t    return {n: p.model_dump() for n, p in reg.projects.items()}\n31\t\n32\t\n33\tdef registry_set(project: str, fields: dict) -> dict:\n34\t    \"\"\"Modifie des champs d'un projet dans registry.yaml. C'est ainsi que tu consignes tes constats (`service` si absent, `container`, `port`, `compose_file`, `build`, `static_dir`), ex. {\"container\": \"web\", \"port\": 8420}. Valeur null = supprimer le champ.\"\"\"\n35\t    return {project: config.set_project_fields(project, **fields).model_dump(exclude_defaults=True)}\n36\t\n37\t\n38\tdef repo_sync(project: str, pr: int | None = None) -> dict:\n39\t    \"\"\"Clone (première fois) ou met à jour le repo du projet au bon endroit (/srv/apps/<P>/repo, ou previews/pr-<N>/repo), sur `ref` du registre (ou la tête de la PR). Retourne le chemin et le commit.\"\"\"\n40\t    t = _target(project, pr)\n41\t    commit = compose.fetch(t)\n42\t    files = sorted(p.name for p in t.repo_dir.iterdir() if not p.name.startswith(\".git\"))\n43\t    return {\"path\": str(t.repo_dir), \"commit\": commit, \"ref\": t.project.ref if pr is None else f\"refs/pull/{pr}/head\",\n44\t            \"has_compose\": (t.repo_dir / t.project.compose_file).exists(), \"has_dockerfile\": (t.repo_dir / \"Dockerfile\").exists(),\n45\t            \"top_level\": files[:50]}\n46\t\n47\t\n48\tdef compose_override(project: str, pr: int | None = None) -> dict:\n49\t    \"\"\"Génère /srv/apps/<P>/compose.override.yml (ports publiés neutralisés, restart, labels Traefik + réseau traefik-net sur `container`, bind mounts `data:`, env_file si env:true) et le .env déchiffré. Pour `service: static`, génère aussi compose.static.yml (nginx) après le `build:`. Échoue si le repo n'a pas de compose, si `container`/`port` manquent (lis le compose/Dockerfile et fixe-les d'abord via registry_set) ou si le container n'existe pas. Retourne le contenu généré, la commande `docker compose` à utiliser et les variables manquantes.\"\"\"\n50\t    t = _target(project, pr)\n51\t    if not t.repo_dir.exists():\n52\t        raise FileNotFoundError(f\"repo non synchronisé : appelle repo_sync({project!r}) d'abord\")\n53\t    if t.project.service != \"static\" and not t.compose_file.exists():\n54\t        raise FileNotFoundError(f\"pas de {t.project.compose_file} dans {t.repo_dir} : ce projet n'est pas un `service: compose`. \"\n55\t                                \"Écris un Dockerfile + docker-compose.yml (PR sur le repo, voir migrate-legacy) ou passe en `service: static`.\")\n56\t    changed = _render(t)\n57\t    return {\"override\": str(t.override_file), \"content\": t.override_file.read_text(), \"changed\": changed,\n58\t            \"env_file\": str(t.env_file) if t.env_file.exists() else None, \"missing_env\": missing_env_vars(t),\n59\t            \"compose_cmd\": \" \".join(compose.compose_cmd(t))}\n60\t\n61\t\n62\tdef traefik_labels_tool(project: str, pr: int | None = None) -> dict:\n63\t    \"\"\"Calcule les labels Traefik voulus pour le projet (routeurs private/public selon `expose`, port) sans rien écrire. Utile pour écrire un override à la main.\"\"\"\n64\t    t = _target(project, pr)\n65\t    return {\"labels\": traefik_labels(t), \"networks\": [\"traefik-net\"], \"urls\": t.urls}\n66\t\n67\t\n68\tdef env_decrypt(project: str, pr: int | None = None) -> dict:\n69\t    \"\"\"Déchiffre secrets/projects/<P>.env vers /srv/apps/<P>/.env (0600). Retourne uniquement les NOMS de variables. Supprime le fichier si env: false.\"\"\"\n70\t    t = _target(project, pr)\n71\t    t.dir.mkdir(parents=True, exist_ok=True)\n72\t    if not t.project.env:\n73\t        render_env(t)\n74\t        return {\"env_file\": None, \"note\": \"env: false dans le registre ; aucun .env écrit\"}\n75\t    render_env(t)\n76\t    return {\"env_file\": str(t.env_file), \"keys\": secrets.keys(secrets.project_env_path(project))}\n77\t\n78\t\n79\tdef secrets_keys_tool(rel: str) -> dict:\n80\t    \"\"\"Noms des variables d'un secret chiffré (ex. 'projects/catacombes.env', 'infra.env'). Jamais les valeurs.\"\"\""}]},"parent_tool_use_id":null,"session_id":"fd3acd69-38c1-4560-9a1a-f04596739d38","uuid":"0a6cc81a-f6d8-44e1-bf38-411e316b1af7","timestamp":"2026-10-21T21:40:43.442Z","tool_use_result":{"type":"text","file":{"filePath":"/srv/infra/tool/infra/tools.py","content":"\"\"\"Tools atomiques exposés au LLM (MCP) et au CLI. Chaque fonction fait UNE chose, est idempotente,\net lève une erreur explicite quand elle ne s'applique pas (le LLM fait alors autrement).\"\"\"\nfrom __future__ import annotations\n\nfrom . import compose, config, dns, paths, secrets, stack\nfrom .render import Target, missing_env_vars, render_env, traefik_labels\nfrom .render import render as _render\n\n\ndef _target(project: str, pr: int | None = None) -> Target:\n    return Target(project, config.project(project), config.host(), pr)\n\n\ndef host_info() -> dict:\n    \"\"\"Décrit l'hôte : host.yaml (IP Tailscale, zones DNS, mode d'ingress public, tunnel, stacks, exceptions), chemins conventionnels.\"\"\"\n    h = config.host()\n    return {\n        \"host\": h.model_dump(),\n        \"paths\": {\"config\": str(paths.config_dir()), \"tool\": str(paths.tool_dir()), \"apps\": str(paths.apps_dir()),\n                  \"data\": str(paths.data_dir()), \"stack_state\": str(paths.stack_state_dir())},\n        \"conventions\": str(paths.tool_dir() / \"docs\" / \"conventions.md\"),\n    }\n\n\ndef registry_get(project: str | None = None) -> dict:\n    \"\"\"Lit registry.yaml : l'entrée d'un projet, ou toutes.\"\"\"\n    reg = config.registry()\n    if project:\n        return {project: config.project(project).model_dump()}\n    return {n: p.model_dump() for n, p in reg.projects.items()}\n\n\ndef registry_set(project: str, fields: dict) -> dict:\n    \"\"\"Modifie des champs d'un projet dans registry.yaml. C'est ainsi que tu consignes tes constats (`service` si absent, `container`, `port`, `compose_file`, `build`, `static_dir`), ex. {\"container\": \"web\", \"port\": 8420}. Valeur null = supprimer le champ.\"\"\"\n    return {project: config.set_project_fields(project, **fields).model_dump(exclude_defaults=True)}\n\n\ndef repo_sync(project: str, pr: int | None = None) -> dict:\n    \"\"\"Clone (première fois) ou met à jour le repo du projet au bon endroit (/srv/apps/<P>/repo, ou previews/pr-<N>/repo), sur `ref` du registre (ou la tête de la PR). Retourne le chemin et le commit.\"\"\"\n    t = _target(project, pr)\n    commit = compose.fetch(t)\n    files = sorted(p.name for p in t.repo_dir.iterdir() if not p.name.startswith(\".git\"))\n    return {\"path\": str(t.repo_dir), \"commit\": commit, \"ref\": t.project.ref if pr is None else f\"refs/pull/{pr}/head\",\n            \"has_compose\": (t.repo_dir / t.project.compose_file).exists(), \"has_dockerfile\": (t.repo_dir / \"Dockerfile\").exists(),\n            \"top_level\": files[:50]}\n\n\ndef compose_override(project: str, pr: int | None = None) -> dict:\n    \"\"\"Génère /srv/apps/<P>/compose.override.yml (ports publiés neutralisés, restart, labels Traefik + réseau traefik-net sur `container`, bind mounts `data:`, env_file si env:true) et le .env déchiffré. Pour `service: static`, génère aussi compose.static.yml (nginx) après le `build:`. Échoue si le repo n'a pas de compose, si `container`/`port` manquent (lis le compose/Dockerfile et fixe-les d'abord via registry_set) ou si le container n'existe pas. Retourne le contenu généré, la commande `docker compose` à utiliser et les variables manquantes.\"\"\"\n    t = _target(project, pr)\n    if not t.repo_dir.exists():\n        raise FileNotFoundError(f\"repo non synchronisé : appelle repo_sync({project!r}) d'abord\")\n    if t.project.service != \"static\" and not t.compose_file.exists():\n        raise FileNotFoundError(f\"pas de {t.project.compose_file} dans {t.repo_dir} : ce projet n'est pas un `service: compose`. \"\n                                \"Écris un Dockerfile + docker-compose.yml (PR sur le repo, voir migrate-legacy) ou passe en `service: static`.\")\n    changed = _render(t)\n    return {\"override\": str(t.override_file), \"content\": t.override_file.read_text(), \"changed\": changed,\n            \"env_file\": str(t.env_file) if t.env_file.exists() else None, \"missing_env\": missing_env_vars(t),\n            \"compose_cmd\": \" \".join(compose.compose_cmd(t))}\n\n\ndef traefik_labels_tool(project: str, pr: int | None = None) -> dict:\n    \"\"\"Calcule les labels Traefik voulus pour le projet (routeurs private/public selon `expose`, port) sans rien écrire. Utile pour écrire un override à la main.\"\"\"\n    t = _target(project, pr)\n    return {\"labels\": traefik_labels(t), \"networks\": [\"traefik-net\"], \"urls\": t.urls}\n\n\ndef env_decrypt(project: str, pr: int | None = None) -> dict:\n    \"\"\"Déchiffre secrets/projects/<P>.env vers /srv/apps/<P>/.env (0600). Retourne uniquement les NOMS de variables. Supprime le fichier si env: false.\"\"\"\n    t = _target(project, pr)\n    t.dir.mkdir(parents=True, exist_ok=True)\n    if not t.project.env:\n        render_env(t)\n        return {\"env_file\": None, \"note\": \"env: false dans le registre ; aucun .env écrit\"}\n    render_env(t)\n    return {\"env_file\": str(t.env_file), \"keys\": secrets.keys(secrets.project_env_path(project))}\n\n\ndef secrets_keys_tool(rel: str) -> dict:\n    \"\"\"Noms des variables d'un secret chiffré (ex. 'projects/catacombes.env', 'infra.env'). Jamais les valeurs.\"\"\"","numLines":80,"startLine":1,"totalLines":120}},"tool_result_meta":[{"id":"toolu_01Wk7WVpjbakdyAUS6THBdoD","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
