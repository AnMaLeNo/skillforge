{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JEtNrb7Scxxbw1snYWqm62","type":"tool_result","content":"server {\n  listen 5173;\n  server_name _;\n\n  root /usr/share/nginx/html;\n  index index.html;\n\n  location /api/ {\n    proxy_pass http://api:3000;\n    proxy_http_version 1.1;\n    proxy_set_header Host $host;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n    proxy_set_header X-Forwarded-Proto $scheme;\n\n    # Server-Sent Events: pas de buffering sur le flux /api/events.\n    # proxy_read_timeout borne le temps qu'une connexion zombie (client parti\n    # sans fermeture propre) peut squatter une ressource. 1h suffit largement :\n    # le heartbeat SSE (cf. API) réémet du trafic toutes les 30s, donc une\n    # connexion vivante ne le déclenche jamais.\n    proxy_buffering off;\n    proxy_cache off;\n    proxy_read_timeout 1h;\n  }\n\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n2:const mqtt = require('mqtt');\n5:const MQTT_HOST = process.env.MQTT_HOST || 'localhost';\n6:const MQTT_PORT = Number(process.env.MQTT_PORT) || 1883;\n8:const mqttClient = mqtt.connect(`mqtt://${MQTT_HOST}:${MQTT_PORT}`);\n39:mqttClient.on('connect', () => {\n40:  fastify.log.info('Connecté au Broker MQTT');\n41:  mqttClient.subscribe([TOPIC_LOG, TOPIC_STATUS], (err) => {\n47:mqttClient.on('error', (err) => {\n48:  fastify.log.error('Erreur MQTT:', err);\n55:mqttClient.on('message', (topic, payload) => {\n114:      description: 'Bad Gateway - Échec de la transmission MQTT',\n124:  const mqttUp = mqttClient.connected;\n125:  reply.code(mqttUp ? 200 : 503).send({\n126:    status: mqttUp ? 'ok' : 'degraded',\n127:    mqtt: mqttUp ? 'connected' : 'disconnected'\n134:  if (!mqttClient.connected) {\n136:      error: 'Service MQTT indisponible',\n137:      code: 'MQTT_DISCONNECTED'\n143:    await mqttClient.publishAsync(TOPIC_COMMAND, action, { qos: 1 });\n151:    fastify.log.error